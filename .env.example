# Gateway
PORT=8788

# Swarm. Unset, the gateway stores blobs locally so the flow still runs.
# Set both to upload to a real Bee node with the app's postage batch.
BEE_URL=
POSTAGE_BATCH_ID=

# How long a transfer lives before it lapses (default 3 days)
TRANSFER_TTL_MS=259200000


# Circle user-controlled wallets (Google sign-in)
# Key from Circle console -> Keys. Never commit the real value.
CIRCLE_API_KEY=
# App ID from Circle console -> Wallets -> User Controlled -> Configurator. Public.
CIRCLE_APP_ID=
# OAuth client ID from Google Cloud Console. Public.
GOOGLE_CLIENT_ID=

# Receipt contract, written here by the setup page after it deploys
RECEIPTS_ADDRESS=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Bee node (docker compose brings one up in light mode)
BEE_URL=http://localhost:1633
GNOSIS_RPC=https://rpc.gnosischain.com
BEE_PASSWORD=change-me

# Postage batch. The admin panel buys one and records it in .storage/config.json;
# set it here only to reuse a batch you already own.
POSTAGE_BATCH_ID=

# Mainnet, read-only: used to check a name is not already owned for real
MAINNET_RPC=https://ethereum-rpc.publicnode.com
