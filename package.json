{
  "name": "pinesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gateway": "node gateway/server.js",
    "bundle": "npm run bundle:ext && npm run bundle:claim",
    "bundle:ext": "esbuild extension/src/popup.js --bundle --format=esm --outfile=extension/lib/popup.bundle.js",
    "bundle:claim": "esbuild web/src/claim.js --bundle --format=esm --outfile=web/claim.bundle.js"
  },
  "dependencies": {
    "@ethersphere/bee-js": "^11.1.1",
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "express": "^4.21.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
