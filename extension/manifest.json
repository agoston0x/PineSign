{
  "manifest_version": 3,
  "name": "PineSign",
  "version": "0.2.0",
  "description": "Encrypt a file on your machine and send it verifiably. Nothing readable ever leaves your computer.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "lib/background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://localhost:*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://localhost:*/*", "https://*/*"]
}
